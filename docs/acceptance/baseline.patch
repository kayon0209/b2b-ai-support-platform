+async def load_history(
+    session: AsyncSession, event: ClaimedEvent, deps: OrchestratorDeps
+) -> list[Turn]:
+    """Prior turns of this conversation, oldest first (plan 2.2/2.3).
+
+    Merge policy, in priority order:
