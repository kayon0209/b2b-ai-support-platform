# Base URL for the FastAPI control plane. The SPA prepends this to every
# request. In dev, leave it as "/api" so vite.config.ts proxies to localhost:8000.
VITE_API_BASE_URL=/api

# Optional static bearer token. In production the SPA should obtain this from
# the Keycloak OIDC flow; this is a convenience for local runs against a
# token-issuing setup. When unset, the UI sends no Authorization header and
# the API returns 401 (shown as an "sign-in required" notice).
VITE_API_TOKEN=

# Where the API actually lives when not using the dev proxy.
VITE_API_TARGET=http://localhost:8000
