# Build output and dependency tree. `dist/` is regenerated by `npm run build`;
# node_modules is restored by `npm ci` in CI and on a fresh clone.
node_modules/
dist/

# Vite/TS incremental build state.
*.tsbuildinfo

# Vite writes these next to vite.config.ts when it has to transpile the config
# itself. They are machine- and run-specific and must never be committed.
vite.config.ts.timestamp-*.mjs

# Local env overrides. `.env.example` is committed; real tokens are not.
.env
.env.local
