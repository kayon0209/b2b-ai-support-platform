.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
secrets-report.json
raw-scan.json

# Local environment: holds provider credentials. Never commit.
.env
.env.*
!.env.example

# Generated test reports (regenerated on every migration/perf run).
tests/artifacts/

# Agent workspace root. Everything below it is one machine's dialogue with
# itself - session logs, long-term project notes, probe output, screenshots -
# generated by local tooling and meaningless to anyone else. Never committed.
#
# History worth keeping honest: the 2026-09-20 rule treated
# `.workbuddy-ai/memory/` as "the project memory to be committed" and ignored
# only `.workbuddy/`. The directory therefore slipped past every `git add` and
# reached the remote, taking a bootstrap token in clear text with it. Both trees
# are local-only now, and the sub-path rules this file used to carry
# (acceptance/, artifacts/) are subsumed by the parent. - 2026-09-23
.workbuddy/
.workbuddy-ai/

# 交付报告与运行产物：不属于代码库内容。
# `outputs/` 里混有个人求职材料（面试题库、项目案例），此前未被忽略，
# 任何一次 `git add .` 都会把它们带进仓库。- 2026-09-20
outputs/
output/

# 运行日志：由本地跑出来，不是源码，且每次运行都会变。
docs/acceptance/*.log

# 本机生成的标识（种子脚本的 demo 身份等）。每台机器不同，不该进仓库；
# `scripts/seed_admin_demo.py` 首次运行会创建它。- 2026-09-20
.local/

# Compiled components for the behaviour tests. Regenerated by
# `npm test` via `tests/build-components.mjs`, and only readable after that
# step - so committing it would put a derived artefact under version control
# and hide a build break as a diff.
apps/admin-web/tests/.built/
