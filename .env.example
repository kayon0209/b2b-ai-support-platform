# Local-only settings. Copy to .env for a development checkout.
# This file contains no provider credentials and must never hold production values.
APP_ENVIRONMENT=local
APP_SECRET_KEY=local-dev-secret-change-me
APP_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/platform
APP_DATABASE_APP_URL=postgresql+psycopg://platform_app:platform_app@localhost:5435/platform
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=10
APP_DATABASE_APP_POOL_SIZE=10
APP_DATABASE_APP_MAX_OVERFLOW=10
APP_ADMIN_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/platform
APP_REDIS_URL=redis://localhost:6380/0
APP_RATE_LIMIT_REQUESTS=600
APP_RATE_LIMIT_WORKBENCH_REQUESTS=24000
APP_RATE_LIMIT_WINDOW_SECONDS=60

# Development authentication only. Unsigned bootstrap tokens are refused
# outside local/test. Production must configure OIDC and use the web PKCE flow.
APP_ALLOW_BOOTSTRAP_TOKENS=true

# Local adapters only; no external API key is required for UI handoff testing.
APP_BUSINESS_API_ADAPTER=demo
APP_PRICING_RULESET=empty
APP_OBJECT_STORAGE_ACCESS_KEY=minioadmin
APP_OBJECT_STORAGE_SECRET_KEY=minioadmin

# Optional model provider. Leave APP_LLM_API_KEY unset to exercise deterministic
# failure/handoff paths without transmitting customer data to an external model.
APP_LLM_BASE_URL=https://api.moark.com/v1
APP_LLM_MODEL=qwen3.8-flash
APP_LLM_EMBEDDING_MODEL=Qwen3-Embedding-8B
APP_LLM_RERANK_MODEL=bge-reranker-v2-m3
APP_LLM_EMBEDDING_DIMENSIONS=1536
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_MAX_RETRIES=2
APP_RERANK_TIMEOUT_SECONDS=2
