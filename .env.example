# Local environment. Gitignored: never commit real credentials.
# Copy to .env and fill in the values for your environment.

APP_ENVIRONMENT=local
APP_SECRET_KEY=local-dev-secret-change-me

# ai-postgres is published on 5435 by infra/compose/docker-compose.yml
APP_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/platform
APP_REDIS_URL=redis://localhost:6380/0
APP_ADMIN_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/platform

# Chatwoot (customer-service kernel)
APP_CHATWOOT_BASE_URL=http://localhost:3000
APP_CHATWOOT_API_TOKEN=
# Must equal the `secret` on the Chatwoot webhook row that points at
# /v1/webhooks/chatwoot, or every delivery is rejected with 401 and the
# platform looks silent rather than misconfigured. The local compose stack
# creates that row with `local-dev-webhook-secret`.
APP_CHATWOOT_WEBHOOK_SECRET=local-dev-webhook-secret

# LLM provider: Gitee AI / 模力方舟 (OpenAI-compatible surface).
# Leave APP_LLM_API_KEY unset to keep the model boundary closed.
APP_LLM_BASE_URL=https://ai.gitee.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=qwen3.8-flash
APP_LLM_EMBEDDING_MODEL=Qwen3-Embedding-8B
APP_LLM_RERANK_MODEL=bge-reranker-v2-m3
# Must match the chunks.embedding vector(1536) column.
APP_LLM_EMBEDDING_DIMENSIONS=1536
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_MAX_RETRIES=2
APP_RERANK_TIMEOUT_SECONDS=2

# Keycloak / OIDC
# When set, OIDC is the authentication path and the bootstrap scheme below is
# ignored. Leave unset only for local work against a realm that does not exist.
APP_OIDC_ISSUER=http://localhost:8081/realms/platform
APP_OIDC_AUDIENCE=platform-api

# DEVELOPMENT ONLY, and ignored whenever APP_OIDC_ISSUER is set.
#
# The bootstrap token format is `pt_<tenant-slug>_<user-uuid>` - unsigned, so
# anyone who knows a slug and a user id can impersonate that user. It exists so
# the API and admin UI can be exercised before a Keycloak realm is available.
#
# Startup refuses this flag outside local/test, and refuses to start at all if
# neither OIDC nor this flag is configured (so an unauthenticated deployment
# cannot be produced by simply forgetting to configure anything).
APP_ALLOW_BOOTSTRAP_TOKENS=false
